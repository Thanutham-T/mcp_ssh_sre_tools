FROM debian:bookworm

# Install SSH server
RUN apt-get update && apt-get install -y openssh-server iproute2 sudo && \
    mkdir -p /var/run/sshd

# Create dedicated 'sre-agent' user
RUN useradd -m -s /bin/bash sre-agent && \
    echo 'sre-agent:secretpassword' | chpasswd && \
    usermod -aG sudo sre-agent

# Allow sudo without password for 'sre-agent'
RUN echo "sre-agent ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Set up SSH directory for the user
RUN mkdir -p /home/sre-agent/.ssh && \
    echo "ssh-rsa  root@Cohh" > /home/sre-agent/.ssh/authorized_keys && \
    chmod 700 /home/sre-agent/.ssh && \
    chmod 600 /home/sre-agent/.ssh/authorized_keys && \
    chown -R sre-agent:sre-agent /home/sre-agent/.ssh

# Configure SSH server
RUN sed -i 's/#Port 22/Port 27036/' /etc/ssh/sshd_config
RUN sed -i 's/#PasswordAuthentication yes/PasswordAuthentication yes/' /etc/ssh/sshd_config
RUN sed -i 's/PermitRootLogin prohibit-password/PermitRootLogin no/' /etc/ssh/sshd_config

# Expose ssh port
EXPOSE 27036

CMD ["/usr/sbin/sshd", "-D"]